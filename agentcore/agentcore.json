{
  "name": "luna",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "luna",
      "description": "Luna personal assistant (AWS UG Ensenada)",
      "build": "CodeZip",
      "entrypoint": "app.py",
      "codeLocation": "assistant",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "LUNA_DATA_DIR",
          "value": "/tmp/luna"
        },
        {
          "name": "TZ",
          "value": "America/Tijuana"
        }
      ],
      "protocol": "HTTP",
      "additionalPolicies": [
        "../agentcore/luna.policy.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "publicapis"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "lunatools",
      "protocolType": "None",
      "description": "Weather and currency tools for Luna (AWS UG Ensenada)",
      "targets": [
        {
          "name": "weather",
          "targetType": "openApiSchema",
          "outboundAuth": {
            "type": "API_KEY",
            "credentialName": "publicapis"
          },
          "schemaSource": {
            "inline": {
              "path": "agentcore/openapi/weather.json"
            }
          }
        },
        {
          "name": "currency",
          "targetType": "openApiSchema",
          "outboundAuth": {
            "type": "API_KEY",
            "credentialName": "publicapis"
          },
          "schemaSource": {
            "inline": {
              "path": "agentcore/openapi/currency.json"
            }
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}
